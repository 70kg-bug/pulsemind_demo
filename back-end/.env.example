# Copy to .env and fill in. .env is gitignored (back-end/.gitignore:2) and must
# stay that way -- this repository is public.

# MongoDB Atlas. Reserved characters in the PASSWORD must be percent-encoded,
# because the connection string is a URI and the driver splits userinfo on the
# first unescaped `@`:
#     @ -> %40      : -> %3A      / -> %2F      ? -> %3F      # -> %23
# Include a database name in the path, or the driver silently uses `test`.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pulsemind?appName=Pulsemind

# The FastAPI model service (pythonService/). Node proxies to it and stores what
# it returns; the service itself holds no durable state.
MODEL_SERVICE_URL=http://127.0.0.1:8000

PORT=3500

# Only needed once the JWT scaffolding in middleware/ is actually mounted.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
